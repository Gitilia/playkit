{
  "name": "@levkin/playkit",
  "version": "0.4.0",
  "description": "Shared Playwright + API test kit — browser helpers, API client, logging, performance, Grafana/Prometheus metrics",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "playkit": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js",
      "require": "./dist/browser/index.cjs"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js",
      "require": "./dist/api/index.cjs"
    },
    "./mail": {
      "types": "./dist/mail/index.d.ts",
      "import": "./dist/mail/index.js",
      "require": "./dist/mail/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "ROADMAP.md",
    "LICENSE",
    "docs/NPM_REGISTRY.md",
    "docs/CONSUMER.md"
  ],
  "scripts": {
    "build": "tsup && chmod +x dist/cli.js",
    "prepare": "npm run build",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "selftest": "playwright test -c selftest/playwright.config.ts",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "example:api": "tsx examples/api/health.example.ts"
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^22.15.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "registry": "https://git.levkin.ca/api/packages/ilia/npm/"
  },
  "repository": {
    "type": "git",
    "url": "https://git.levkin.ca/ilia/playkit.git"
  },
  "keywords": [
    "playwright",
    "e2e",
    "api-testing",
    "observability",
    "grafana",
    "prometheus"
  ]
}
